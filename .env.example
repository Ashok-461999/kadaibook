# ---------------------------------------------------------------------------
# KadaiBook local configuration. Copy to .env and fill in only what you need.
# The compose stack defaults to the deterministic mock vision provider so the
# whole flow runs offline. Set VISION_PROVIDER to use a real model.
# ---------------------------------------------------------------------------

# Vision provider: mock | google | openai_compatible | anthropic
# Default is the offline mock provider. Set google and add a key to use Gemini.
VISION_PROVIDER=mock
VISION_MODEL=mock-v1
# Google AI Studio / Gemini API key. Never commit a real key.
GOOGLE_API_KEY=
GOOGLE_THINKING_LEVEL=low
# For openai_compatible: any OpenAI-compatible chat-completions endpoint
# (OpenAI, Azure-compatible gateway, OpenRouter, Groq, Ollama, ...).
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
# For anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional hard cap per call
VISION_TIMEOUT_SECONDS=90
VISION_MAX_OUTPUT_TOKENS=4096
# Optional shared secret for Core API -> AI service calls
AI_SERVICE_TOKEN=dev-internal-token
# Optional cost accounting (paise per 1M tokens)
VISION_INPUT_COST_PAISE_PER_MTOK=0
VISION_OUTPUT_COST_PAISE_PER_MTOK=0

# Core API
JWT_SECRET=dev-only-change-me-to-a-long-random-secret-at-least-32-chars
AI_SERVICE_URL=http://ai-service:8000
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/pages
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
IMAGE_RETENTION_DAYS=30
DEMO_SEED=true

# S3 mode (set STORAGE_BACKEND=s3)
AWS_REGION=ap-south-1
S3_BUCKET=
S3_KMS_KEY_ID=

# Postgres (compose default)
POSTGRES_DB=kadaibook
POSTGRES_USER=kadai
POSTGRES_PASSWORD=kadai
